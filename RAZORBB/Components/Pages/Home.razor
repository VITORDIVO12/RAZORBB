@inject NavigationManager navigation
@page "/"

<img src="imagem/SP.jpg" class="w-25"  />


<h1>LOGIN SUPER LEGAL</h1><br /> 

<label>Nome</label><br /> 
<input type="text" class="from control w-25" @bind="nome"/><br />
<br /> <br /> 
<label>Senha</label><br /> 
<input type="password" class="from control w-25" @bind="senha"/><br /> 
<br /> 
<button class="btn btn-outline-success" @onclick="Login">Entrar</button>


<p>mensagem: @mensagem</p>

@code{
 string nome;
 string senha;
 string mensagem;
 


 void Login()
 {
     if (nome == "admin" && senha == "1234vitor")
     {
         //mensagem = "Slk fi logou";
         navigation.NavigateTo("/cadastrar");
     }
     else
     {
         mensagem = "JOGOU BIZARRO BUT";
     }
 }
}